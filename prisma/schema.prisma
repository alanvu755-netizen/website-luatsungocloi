datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Core Tenant Scope & RBAC
// ----------------------------------------------------
model Site {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  domain           String?           @unique
  status           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  users            AdminUser[]
  settings         SiteSettings?
  hero             Hero?
  introduction     Introduction?
  education        Education[]
  experience       Experience[]
  practiceAreas    PracticeArea[]
  commitment       Commitment?
  contactChannels  ContactChannel[]
  media            Media[]
  menus            Menu[]
  submenus         Submenu[]
  articles         Article[]
  articlePracticeAreas ArticlePracticeArea[]
  consultationLeads ConsultationLead[]
  statisticItems   StatisticItem[]
  siteAddOns       SiteAddOn[]
  aiSiteConfigs    AISiteConfig[]
  aiGenerations    AIGeneration[]
  aiUsages         AIUsage[]
  aiKnowledgeItems AIKnowledgeItem[]
  auditLogs        AuditLog[]
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique // "SYSADMIN", "SITE_ADMIN", "EDITOR"
  description     String?
  rolePermissions RolePermission[]
  users           AdminUser[]
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  description     String
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)

  @@unique([userId, permissionId])
}

model AdminUser {
  id              String           @id @default(cuid())
  siteId          String?          // Null for SYSADMIN, required for SITE_ADMIN & EDITOR
  site            Site?            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  roleId          String
  role            Role             @relation(fields: [roleId], references: [id])
  name            String
  email           String           @unique
  passwordHash    String
  status          Boolean          @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  userPermissions UserPermission[]
  auditLogs       AuditLog[]
  aiGenerations   AIGeneration[]
  globalAIConfigs GlobalAIConfig[]
  createdArticles Article[]
}

// ----------------------------------------------------
// CMS Models (Phase 1 Singleton + Draft/Pub Fields)
// ----------------------------------------------------
model Hero {
  id             String   @id @default(cuid())
  siteId         String   @unique
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  draftSubtitle  String   @default("Luật sư - Thạc sĩ")
  draftName      String   @default("LÊ THỊ NGỌC LỢI")
  draftImageId   String?
  draftImageUrl  String?  @default("/customer-reference.png")
  draftLogoId    String?

  draftTitle1    String?  @default("ĐỒNG HÀNH PHÁP LÝ")
  pubTitle1      String?  @default("ĐỒNG HÀNH PHÁP LÝ")
  draftTitle2    String?  @default("BẢO VỆ QUYỀN & LỢI ÍCH HỢP PHÁP")
  pubTitle2      String?  @default("BẢO VỆ QUYỀN & LỢI ÍCH HỢP PHÁP")
  draftDescription String? @default("Luật sư Lê Thị Ngọc Lợi và cộng sự cam kết mang đến giải pháp pháp lý hiệu quả – tận tâm – bảo mật – chuyên nghiệp.")
  pubDescription   String? @default("Luật sư Lê Thị Ngọc Lợi và cộng sự cam kết mang đến giải pháp pháp lý hiệu quả – tận tâm – bảo mật – chuyên nghiệp.")
  draftBadgesJson  String?
  pubBadgesJson    String?
  draftCtaPrimaryText String? @default("TƯ VẤN NGAY")
  pubCtaPrimaryText   String? @default("TƯ VẤN NGAY")
  draftCtaSecondaryText String? @default("XEM LĨNH VỰC HOẠT ĐỘNG")
  pubCtaSecondaryText   String? @default("XEM LĨNH VỰC HOẠT ĐỘNG")
  
  pubSubtitle    String   @default("Luật sư - Thạc sĩ")
  pubName        String   @default("LÊ THỊ NGỌC LỢI")
  pubImageId     String?
  pubImageUrl    String?  @default("/customer-reference.png")
  pubLogoId      String?
  
  status         String   @default("PUBLISHED") // "DRAFT", "PUBLISHED", "HIDDEN"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Introduction {
  id           String   @id @default(cuid())
  siteId       String   @unique
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  draftTitle   String   @default("GIỚI THIỆU")
  draftContent String
  draftImageUrl String? @default("/NgocLoi-office.jpg")
  pubTitle     String   @default("GIỚI THIỆU")
  pubContent   String
  pubImageUrl   String? @default("/NgocLoi-office.jpg")
  status       String   @default("PUBLISHED") // "DRAFT", "PUBLISHED", "HIDDEN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Education {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  degree       String
  institution  String
  description  String?
  startYear    Int?
  endYear      Int?
  displayOrder Int      @default(0)
  status       String   @default("PUBLISHED") // "DRAFT", "PUBLISHED", "HIDDEN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([siteId, status, displayOrder])
}

model Experience {
  id           String                @id @default(cuid())
  siteId       String
  site         Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  startYear    Int
  endYear      Int?
  position     String
  organization String
  description  String?
  displayOrder Int                   @default(0)
  status       String                @default("PUBLISHED") // "DRAFT", "PUBLISHED", "HIDDEN"
  highlights   ExperienceHighlight[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([siteId, status, displayOrder])
}

model ExperienceHighlight {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  content      String
  displayOrder Int        @default(0)
}

model PracticeArea {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  icon         String?
  displayOrder Int      @default(0)
  status       String   @default("PUBLISHED") // "DRAFT", "PUBLISHED", "HIDDEN"
  articlePracticeAreas ArticlePracticeArea[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([siteId, status, displayOrder])
}

model Commitment {
  id           String   @id @default(cuid())
  siteId       String   @unique
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  draftHeading String   @default("Tận tâm – Chuyên nghiệp – Bảo mật – Hiệu quả")
  draftContent String
  pubHeading   String   @default("Tận tâm – Chuyên nghiệp – Bảo mật – Hiệu quả")
  pubContent   String
  status       String   @default("PUBLISHED") // "DRAFT", "PUBLISHED", "HIDDEN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactChannel {
  id            String   @id @default(cuid())
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  platform      String   // "ZALO", "TELEGRAM", "FACEBOOK", "LINKEDIN", "YOUTUBE", "WHATSAPP", "OTHER"
  label         String
  value         String?
  url           String
  displayOrder  Int      @default(0)
  status        Boolean  @default(false)
  openInNewTab  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([siteId, status, displayOrder])
}

model SiteSettings {
  id                             String   @id @default(cuid())
  siteId                         String   @unique
  site                           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteName                       String   @default("Luật sư - Thạc sĩ Lê Thị Ngọc Lợi")
  phone                          String   @default("0902 081 061")
  email                          String?
  consultationNotificationEmail String?  @default("luatsungocloi@gmail.com")
  address                        String   @default("Số 149, đường Lê Thị Riêng, phường Cao Lãnh, Đồng Tháp")
  googleMapsUrl                  String?
  floatingContactEnabled         Boolean  @default(true)
  footerDisclaimer               String?  @default("© 2026 Bản quyền thuộc về Luật sư – Thạc sĩ Lê Thị Ngọc Lợi. Tất cả các quyền được bảo hộ.")
  seoTitle                       String?
  seoDescription                 String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model Media {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  alt          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ----------------------------------------------------
// Dynamic Navigation Menu & Chuyên Mục (Submenu)
// ----------------------------------------------------
model Menu {
  id           String    @id @default(cuid())
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  displayOrder Int       @default(0)
  status       String    @default("VISIBLE") // "VISIBLE" | "HIDDEN"
  submenus     Submenu[]
  articles     Article[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, status, displayOrder])
}

model Submenu {
  id           String    @id @default(cuid())
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  menuId       String
  menu         Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  displayOrder Int       @default(0)
  status       String    @default("VISIBLE") // "VISIBLE" | "HIDDEN"
  articles     Article[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([menuId, slug])
  @@index([siteId, menuId, status, displayOrder])
}

// ----------------------------------------------------
// Articles & SEO Content CMS
// ----------------------------------------------------
model Article {
  id              String                @id @default(cuid())
  siteId          String
  site            Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  menuId          String
  menu            Menu                  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  submenuId       String?
  submenu         Submenu?              @relation(fields: [submenuId], references: [id], onDelete: SetNull)
  title           String
  slug            String
  excerpt         String?
  content         String
  thumbnailUrl    String?
  status          String                @default("DRAFT") // "DRAFT" | "PUBLISHED" | "HIDDEN"
  publishedAt     DateTime?
  seoTitle        String?
  metaDescription String?
  keywords        String?
  viewCount       Int                   @default(0)
  shareCount      Int                   @default(0)
  createdById     String
  createdBy       AdminUser             @relation(fields: [createdById], references: [id])
  articlePracticeAreas ArticlePracticeArea[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, status, publishedAt])
  @@index([siteId, menuId, status])
  @@index([siteId, submenuId, status])
}

// ----------------------------------------------------
// PRD v2.1 Step 1 Additions: N-N Junction, Leads & Stats
// ----------------------------------------------------
model ArticlePracticeArea {
  id             String       @id @default(cuid())
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  articleId      String
  article        Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  practiceAreaId String
  practiceArea   PracticeArea @relation(fields: [practiceAreaId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([articleId, practiceAreaId])
  @@index([siteId, practiceAreaId])
  @@index([articleId])
}

model ConsultationLead {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fullName  String   // REQUIRED
  phone     String   // REQUIRED
  email     String?  // OPTIONAL
  content   String   // REQUIRED
  ipAddress String?
  userAgent String?
  status    String   @default("NEW") // "NEW", "CONTACTED", "ARCHIVED"
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

model StatisticItem {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  value        String   // "800+", "500+", "10+", "100%"
  label        String   // "Vụ việc thành công", "Khách hàng tin tưởng"...
  subtext      String?
  displayOrder Int      @default(0)
  status       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([siteId, status, displayOrder])
}

// ----------------------------------------------------
// Global & AI Platform Security Models
// ----------------------------------------------------
model GlobalAIConfig {
  id          String     @id @default("global")
  enabled     Boolean    @default(true)
  updatedAt   DateTime   @updatedAt
  updatedById String?
  updatedBy   AdminUser? @relation(fields: [updatedById], references: [id])
}

model AddOn {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  siteAddOns  SiteAddOn[]
}

model SiteAddOn {
  id          String    @id @default(cuid())
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  addOnId     String
  addOn       AddOn     @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  status      String    @default("ACTIVE") // "ACTIVE", "SUSPENDED", "EXPIRED", "DISABLED"
  activatedAt DateTime  @default(now())
  expiresAt   DateTime?
}

model AIProvider {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  status         Boolean        @default(true)
  credentialRef  String?
  defaultModel   String
  allowedModels  String         // Stored as JSON string array
  aiSiteConfigs  AISiteConfig[]
}

model AISiteConfig {
  id                String      @id @default(cuid())
  siteId            String      @unique
  site              Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  providerId        String
  provider          AIProvider  @relation(fields: [providerId], references: [id])
  monthlyQuota      Int         @default(100) // Maximum requests per month
  monthlyTokenLimit Int         @default(500000) // Optional token limit
  rateLimitRpm      Int         @default(10)
  brandTone         String?
  audience          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model AIKnowledgeItem {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  topic      String
  content    String
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AIPromptTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  template    String
  version     Int      @default(1)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIGeneration {
  id                String    @id @default(cuid())
  requestId         String    @unique
  providerRequestId String?
  siteId            String
  site              Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId            String
  user              AdminUser @relation(fields: [userId], references: [id])
  status            String    @default("REQUESTED") // "REQUESTED", "GENERATING", "COMPLETED", "FAILED", "BLOCKED"
  promptType        String
  model             String
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  estimatedCost     Float     @default(0.0)
  resultDraft       String?
  riskFlags         String    @default("[]") // Stored as JSON string array
  completedAt       DateTime?
  failedAt          DateTime?
  errorCode         String?
  createdAt         DateTime  @default(now())
}

model AIUsage {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  yearMonth    String   // "2026-08" (Single Source of Truth for Usage)
  requestCount Int      @default(0)
  totalTokens  Int      @default(0)
  totalCost    Float    @default(0.0)
  updatedAt    DateTime @updatedAt

  @@unique([siteId, yearMonth])
}

model AuditLog {
  id          String    @id @default(cuid())
  siteId      String?
  site        Site?     @relation(fields: [siteId], references: [id])
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
}

model ContentObjective {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  promptGuidance String
  ctaGuidance    String?
  displayOrder   Int      @default(0)
  status         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
